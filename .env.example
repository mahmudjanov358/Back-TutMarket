# Backend env example
PORT=5000
NODE_ENV=development
# If you use a single DATABASE_URL string, uncomment this and remove discrete vars below
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Discrete DB config (if used by your code instead of DATABASE_URL)
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

JWT_SECRET=replace_with_strong_secret
CORS_ORIGIN=http://localhost:5173
